RUOYI_TOKEN_SECRET=replace-with-at-least-32-random-characters
RUOYI_LOG_LEVEL=info
RUOYI_PROFILE=/opt/ai-streamer/uploads
SPRING_DEVTOOLS_RESTART_ENABLED=false
SWAGGER_ENABLED=false
DRUID_WEB_STAT_FILTER_ENABLED=false
DRUID_STAT_VIEW_ENABLED=false
BUSINESS_AI_DEEPSEEK_ENABLED=true
BUSINESS_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
BUSINESS_AI_DEEPSEEK_API_KEY=replace-with-production-key
BUSINESS_AI_DEEPSEEK_MODEL=deepseek-v4-flash
BUSINESS_AI_DEEPSEEK_CONNECT_TIMEOUT_MS=8000
BUSINESS_AI_DEEPSEEK_READ_TIMEOUT_MS=60000
# 成品供应商退货期限邮件：配置地址和 163 客户端授权码后再开启。
JEWELRY_ALERT_MAIL_ENABLED=false
JEWELRY_ALERT_MAIL_FROM=
JEWELRY_ALERT_MAIL_TO=
JEWELRY_ALERT_SMTP_AUTH_CODE=
