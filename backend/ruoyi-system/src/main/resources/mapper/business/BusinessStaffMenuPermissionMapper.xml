<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.BusinessStaffMenuPermissionMapper">
    <resultMap id="PermissionResult" type="BusinessStaffMenuPermission">
        <id property="userId" column="user_id" />
        <id property="menuId" column="menu_id" />
        <result property="accessLevel" column="access_level" />
        <result property="createBy" column="create_by" />
        <result property="updateBy" column="update_by" />
    </resultMap>

    <select id="selectByUserId" parameterType="Long" resultMap="PermissionResult">
        select user_id, menu_id, access_level, create_by, update_by
        from biz_staff_menu_permission
        where user_id = #{userId}
    </select>

    <delete id="deleteByUserId" parameterType="Long">
        delete from biz_staff_menu_permission where user_id = #{userId}
    </delete>

    <insert id="insertBatch">
        insert into biz_staff_menu_permission(user_id, menu_id, access_level, create_by, create_time, update_by, update_time)
        values
        <foreach collection="items" item="item" separator=",">
            (#{item.userId}, #{item.menuId}, #{item.accessLevel}, #{item.createBy}, sysdate(), #{item.updateBy}, sysdate())
        </foreach>
    </insert>
</mapper>
